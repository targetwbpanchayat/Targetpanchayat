# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GMAIL_USER: Gmail address used to send OTP emails (only needed with backend)
GMAIL_USER=""

# GMAIL_APP_PASSWORD: 16-character Google App Password (only needed with backend)
GMAIL_APP_PASSWORD=""

# VITE_EMAILJS_SERVICE_ID: EmailJS Service ID (from emailjs.com dashboard)
# Create a free account at emailjs.com, add Gmail service, get the Service ID
VITE_EMAILJS_SERVICE_ID="YOUR_SERVICE_ID"

# VITE_EMAILJS_TEMPLATE_ID: EmailJS Template ID
# Create an email template with variables: to_email, to_name, otp_code, subject
VITE_EMAILJS_TEMPLATE_ID="YOUR_TEMPLATE_ID"

# VITE_EMAILJS_PUBLIC_KEY: EmailJS Public Key (from Account > API Keys)
VITE_EMAILJS_PUBLIC_KEY="YOUR_PUBLIC_KEY"

# VITE_API_BASE_URL: Backend API URL (optional, for Render/Railway backend)
# Leave empty if using EmailJS only (no backend needed)
VITE_API_BASE_URL=""
