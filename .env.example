# GEMINI_API_KEY: Required for Gemini AI API calls (Current Affairs generation)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://targetwbpanchayat.github.io/Targetpanchayat/"

# ============================================================
# Firebase Configuration (OTP + User Data)
# ============================================================
# Get these from: Firebase Console > Project Settings > Your apps > Web app
# These are PUBLIC config values (safe to expose). Firebase security
# is enforced by Authentication + Firestore Security Rules.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"

# Gmail SMTP (for password reset / notification emails — optional)
# Firebase Auth handles OTP/verification emails automatically.
# Only set these if you want a custom email sender instead.
# GMAIL_USER="your-email@gmail.com"
# GMAIL_APP_PASSWORD="your-16-char-app-password"

# VITE_API_BASE_URL: Backend API URL (optional — for AI current affairs)
VITE_API_BASE_URL=""
